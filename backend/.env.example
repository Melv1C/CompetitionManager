# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5555/postgres?schema=public"

# Authentication Configuration
BETTER_AUTH_SECRET=some-random-secret-key
BETTER_AUTH_URL=http://localhost:5173

# Log Cleanup Configuration
LOG_CLEANUP_ENABLED=true
LOG_CLEANUP_DAYS_TO_KEEP=30
LOG_CLEANUP_SCHEDULE=@daily

DB_SEED_ENABLED=true
DB_SEED_FORCE_RESEED=false

DB_SEED_USERS_ENABLED=true

DB_SEED_ADMIN_EMAIL=admin@example.com
DB_SEED_ADMIN_PASSWORD=admin-password
DB_SEED_ADMIN_NAME=Admin

DB_SEED_USER_EMAIL=user@example.com
DB_SEED_USER_PASSWORD=user-password
DB_SEED_USER_NAME=User

ATHLETE_SYNC_ENABLED=false
ATHLETE_SYNC_USE_MOCK=true
