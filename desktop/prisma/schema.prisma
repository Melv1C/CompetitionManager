generator client {
  provider = "prisma-client-js"
  output   = "../src/electron/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_LOCAL_URL")
}

model actionsrequired {
  id        Int      @id @default(autoincrement())
  action    String?
  data      Int?
  submitted DateTime @default(now()) @db.Timestamptz(6)
}

model athletes {
  id          Int        @id @default(autoincrement())
  since       DateTime   @default(now()) @db.Timestamptz(6)
  firstname   String     @db.VarChar(128)
  lastname    String     @db.VarChar(128)
  middlename  String?    @db.VarChar(128)
  gender      String     @db.Char(1)
  birthdate   DateTime   @db.Date
  nationality Int        @db.SmallInt
  license    licenses[]

  @@index([firstname], map: "firstname")
  @@index([lastname], map: "lastname")
  @@index([nationality], map: "nationality")
}

model barheights {
  id          Int      @id @default(autoincrement())
  since       DateTime @default(now()) @db.Timestamptz(6)
  round       Int
  startheight Decimal? @db.Decimal(6, 3)
  interval    Decimal? @db.Decimal(6, 3)
  attempts    Int?     @default(3) @db.SmallInt

  @@index([round], map: "round")
}

model callrooms {
  id          Int      @id @default(autoincrement())
  since       DateTime @default(now()) @db.Timestamptz(6)
  competition Int      @db.SmallInt
  seqno       Int      @db.SmallInt
  name        String   @db.VarChar(64)

  @@index([competition], map: "competition")
}

model categories {
  id           Int      @id @default(autoincrement())
  since        DateTime @default(now()) @db.Timestamptz(6)
  federation   Int?     @db.SmallInt
  name         String?  @db.VarChar(64)
  abbreviation String?  @db.VarChar(16)
  minimumtype  String   @default("N") @db.Char(1)
  minimumage   Int?     @db.SmallInt
  maximumtype  String   @default("N") @db.Char(1)
  maximumage   Int?     @db.SmallInt
  gender       String   @db.Char(1)
  class        String?  @db.VarChar(16)
  needslicense String   @db.VarChar(1)
  nationalcode String?  @db.VarChar(16)
  sortorder    Int?     @default(0)

  @@index([abbreviation], map: "abbreviation")
  @@index([class], map: "class")
  @@index([federation], map: "federation")
}

model classes {
  id         Int      @id @default(autoincrement())
  since      DateTime @default(now()) @db.Timestamptz(6)
  athlete    Int
  federation Int      @db.SmallInt
  class      String   @db.VarChar(16)

  @@index([athlete], map: "athlete")
}

model competitionfederationfriends {
  id          Int      @id @default(autoincrement())
  since       DateTime @default(now()) @db.Timestamptz(6)
  competition Int
  federation  Int
}

