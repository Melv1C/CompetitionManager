{
  "name": "competition-manager",
  "version": "0.0.0",
  "description": "Competition Manager",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm run install:core && npm run install:ui && npm run install:backend && npm run install:frontend && npm run install:desktop",
    "install:core": "cd core && npm install",
    "install:ui": "cd ui && npm install",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:desktop": "cd desktop && npm install",
    "build:core": "cd core && npm run build",
    "build:ui": "cd ui && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:desktop": "cd desktop && npm run build",
    "start:backend": "cd backend && npm run start",
    "dev": "npm-run-all --parallel dev:core dev:ui dev:backend dev:frontend",
    "dev:desktop-app": "npm-run-all --parallel dev:core dev:ui dev:backend dev:desktop",
    "dev:core": "cd core && npm run dev",
    "dev:ui": "cd ui && npm run dev",
    "dev:backend": "npm run docker:db && cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:desktop": "cd desktop && npm run dev",
    "storybook": "cd ui && npm run storybook",
    "db:generate": "cd backend && npx prisma generate",
    "db:migrate:dev": "cd backend && npx prisma migrate dev",
    "db:migrate": "cd backend && npx prisma migrate deploy",
    "docker:db": "docker-compose -f docker-compose.db.yml up -d",
    "lint": "npm run lint:core && npm run lint:ui && npm run lint:backend && npm run lint:frontend && npm run lint:desktop",
    "lint:core": "cd core && npm run lint",
    "lint:ui": "cd ui && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:desktop": "cd desktop && npm run lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "i18n": "cd frontend && npm run i18n",
    "i18n:ci": "cd frontend && npm run i18n:ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "i18next-parser": "^9.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.47.0"
  },
  "dependencies": {
    "glob": "^13.0.0"
  }
}
