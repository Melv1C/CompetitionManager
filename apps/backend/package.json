{
  "name": "api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch & tsx watch src/index.ts",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "start": "node ./dist/index.js",
    "seed": "tsx src/seed/index.ts",
    "seed:verbose": "tsx src/seed/index.ts --verbose",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "email": "email dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/zod-validator": "^0.7.6",
    "@react-email/components": "1.0.1",
    "@repo/logger": "*",
    "@repo/utils": "*",
    "axios": "^1.13.2",
    "better-auth": "^1.3.34",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "i18next": "^25.6.3",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.0.4",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.6",
    "react-email": "5.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
